#!/bin/bash

# CoolPing main entry point — sources helper libraries and dispatches

script_dir="$(cd "$(dirname "$0")" && pwd)"
lib_dir="$script_dir/../lib/coolping"

for lib in helpers.sh ping.sh continuous.sh; do
  if [[ -f "$lib_dir/$lib" ]]; then
    # shellcheck source=/dev/null
    source "$lib_dir/$lib"
  else
    echo "Missing library: $lib_dir/$lib" >&2
    exit 1
  fi
done

shopt -s extglob

apply_no_emoji() {
  USE_EMOJI=false
  TICK="[OK]"
  CROSS="[FAIL]"
  INFO="[INFO]"
  WARN="[WARN]"
}

apply_no_color() {
  USE_COLOR=false
  RED=''
  GREEN=''
  BLUE=''
  YELLOW=''
  DIM=''
  NC=''
}

apply_color() {
  USE_COLOR=true
  RED='\033[0;31m'
  GREEN='\033[0;32m'
  BLUE='\033[0;36m'
  YELLOW='\033[1;33m'
  DIM='\033[2m'
  NC='\033[0m'
}

# Auto-detect color support: honor NO_COLOR, dumb terminals, non-tty output
if [[ ! -t 1 ]] || [[ -n "${NO_COLOR:-}" ]] || [[ "${TERM:-}" == "dumb" ]]; then
  apply_no_color
fi

if [[ "${TERM:-}" == "dumb" ]]; then
  apply_no_emoji
fi

show_header() {
  echo

  if command -v figlet >/dev/null 2>&1; then
    if [[ "$USE_COLOR" == true ]] && command -v lolcat >/dev/null 2>&1; then
      figlet -f ANSI\ Shadow "CoolPing" | lolcat
    else
      figlet -f ANSI\ Shadow "CoolPing"
    fi
  elif [[ "$USE_COLOR" == true ]]; then
    echo -e "\033[38;5;39m ██████╗ ██████╗  ██████╗ ██╗\033[38;5;82m██████╗ ██╗███╗   ██╗\033[38;5;214m ██████╗"
    echo -e "\033[38;5;39m██╔════╝██╔═══██╗██╔═══██╗██║\033[38;5;82m██╔══██╗██║████╗  ██║\033[38;5;214m██╔════╝"
    echo -e "\033[38;5;39m██║     ██║   ██║██║   ██║██║\033[38;5;82m██████╔╝██║██╔██╗ ██║\033[38;5;214m██║  ███╗"
    echo -e "\033[38;5;39m██║     ██║   ██║██║   ██║██║\033[38;5;82m██╔═══╝ ██║██║╚██╗██║\033[38;5;214m██║   ██║"
    echo -e "\033[38;5;39m╚██████╗╚██████╔╝╚██████╔╝██║\033[38;5;82m██║     ██║██║ ╚████║\033[38;5;214m╚██████╔╝"
    echo -e "\033[38;5;39m ╚═════╝ ╚═════╝  ╚═════╝ ╚═╝\033[38;5;82m╚═╝     ╚═╝╚═╝  ╚═══╝\033[0m"
  else
    echo " ██████╗ ██████╗  ██████╗ ██╗██████╗ ██╗███╗   ██╗ ██████╗ "
    echo "██╔════╝██╔═══██╗██╔═══██╗██║██╔══██╗██║████╗  ██║██╔════╝"
    echo "██║     ██║   ██║██║   ██║██║██████╔╝██║██╔██╗ ██║██║  ███╗"
    echo "██║     ██║   ██║██║   ██║██║██╔═══╝ ██║██║╚██╗██║██║   ██║"
    echo "╚██████╗╚██████╔╝╚██████╔╝██║██║     ██║██║ ╚████║╚██████╔╝"
    echo " ╚═════╝ ╚═════╝  ╚═════╝ ╚═╝╚═╝     ╚═╝╚═╝  ╚═══╝ ╚═════╝"
  fi

  echo
}

HAS_HELP=false
BAD_OPTS=false

while [[ $# -gt 0 ]]; do
  arg="$1"
  shift

  opt="${arg%%=*}"
  val=""
  if [[ "$arg" == *=* ]]; then
    val="${arg#*=}"
  fi

  case "$opt" in
    --help|-h)
      HAS_HELP=true ;;
    --log)
      LOG_ENABLED=true ;;
    --no-emoji)
      apply_no_emoji ;;
    --color)
      if [[ -n "$val" ]]; then
        cval="$val"
      elif [[ $# -gt 0 ]]; then
        cval="$1"
        shift
      else
        cval=""
      fi
      case "$cval" in
        never) apply_no_color ;;
        always) apply_color ;;
        auto) : ;;
        *)
          echo -e "${RED}${WARN} Invalid value for --color: '$cval' (expected: never, always, auto)${NC}" >&2
          BAD_OPTS=true ;;
      esac ;;
    --count)
      if [[ -n "$val" ]]; then
        cval="$val"
      elif [[ $# -gt 0 ]]; then
        cval="$1"
        shift
      else
        cval=""
      fi
      if validate_count "$cval"; then
        PING_COUNT="$cval"
      else
        echo -e "${RED}${WARN} Invalid count: '$cval' (must be a positive integer)${NC}" >&2
        BAD_OPTS=true
      fi ;;
    --verbose|-v)
      VERBOSE=true ;;
    --continuous|-c)
      CONTINUOUS=true ;;
    -*)
      echo -e "${RED}${WARN} Unknown option: $arg${NC}" >&2
      BAD_OPTS=true ;;
    *)
      if [[ -z "$HOST" ]]; then
        HOST="$arg"
      else
        echo -e "${RED}${WARN} Ignoring extra host: $arg${NC}" >&2
        BAD_OPTS=true
      fi ;;
  esac
done

if [[ "$HAS_HELP" == true ]]; then
  show_header
  show_help
  exit 0
fi

if [[ "$BAD_OPTS" == true ]]; then
  echo -e "${YELLOW}Run with --help for usage.${NC}" >&2
  exit 1
fi

if [[ -z "$HOST" ]]; then
  echo -e "${RED}${WARN} No host provided. Run with --help for usage.${NC}" >&2
  exit 1
fi

show_header

if [[ "$CONTINUOUS" == true ]]; then
  run_continuous
else
  run_ping
fi

exit 0
